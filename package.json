{
  "name": "arabella-mini-games",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",

    "serve": "echo 'http://localhost:8000/app/  (Ctrl+C to stop)' && python3 -m http.server 8000",
    "serve:stop": "fuser -k 8000/tcp || true",

    "bench": "node tools/melee-bench/bench.mjs",
    "bench:quick": "node tools/melee-bench/bench.mjs --n 200",
    "bench:full": "node tools/melee-bench/bench.mjs --n 1000",
    "bench:cmp": "node tools/melee-bench/compare.mjs",
    "bench:last": "node tools/melee-bench/compare.mjs prev latest",

    "test": "node --test \"tools/**/*.test.mjs\""
  }
}
